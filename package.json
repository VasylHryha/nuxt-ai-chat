{
  "name": "nuxt-ai-chat",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "bun run --bun nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "generate": "nuxt generate",
    "preview": "bun run --bun nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .js,.ts,.vue .",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue .",
    "db:migrate": "bun run ./db/scripts/migrate.js",
    "db:reset": "rimraf db/sqlite/app.db && bun db:migrate",
    "db:seed": "bun run db/scripts/seeds.js"
  },
  "dependencies": {
    "@agentic/ai-sdk": "^8.4.4",
    "@agentic/platform-tool-client": "^8.4.4",
    "@ai-sdk/anthropic": "^2.0.29",
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/openai": "^2.0.53",
    "@ai-sdk/vue": "^2.0.71",
    "@node-rs/argon2": "^2.0.2",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/scripts": "^0.13.0",
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.11.2",
    "@tavily/core": "^0.5.12",
    "ai": "^5.0.76",
    "better-sqlite3": "^12.4.1",
    "jose": "^6.1.0",
    "nuxt": "^4.1.3",
    "openai": "^6.3.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.15",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.0.0",
    "@nuxt/test-utils": "^3.19.2",
    "@tailwindcss/vite": "^4.1.15",
    "nuxt-ssr-api-logger": "^2.0.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
