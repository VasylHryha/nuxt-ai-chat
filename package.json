{
  "name": "nuxt-ai-chat",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .js,.ts,.vue .",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue .",
    "db:migrate": "bun run ./db/scripts/migrate.js",
    "db:reset": "rimraf db/sqlite/app.db && pnpm db:migrate",
    "db:seed": "bun run db/scripts/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.29",
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/openai": "^2.0.52",
    "@ai-sdk/vue": "^2.0.71",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@node-rs/argon2": "^2.0.2",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/scripts": "0.12.1",
    "@nuxt/test-utils": "3.19.2",
    "@nuxt/ui": "4.0.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/vite": "^4.1.14",
    "@unhead/vue": "^2.0.3",
    "ai": "^5.0.71",
    "better-sqlite3": "^12.4.1",
    "nuxt": "^4.1.3",
    "openai": "^6.3.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
